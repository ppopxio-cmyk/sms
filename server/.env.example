# Copy these into your host's environment settings (for example Render →
# Environment). Nothing here is a real secret: put the real values in, not in Git.
#
#   Render:  NODE_ENV, TRUST_PROXY, CLIENT_ORIGIN, MONGODB_URI, SMTP_USER,
#            GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GOOGLE_REFRESH_TOKEN,
#            MAIL_FROM_NAME, JWT_ACCESS_SECRET, CODE_HMAC_SECRET,
#            VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT
#
# Do NOT set PORT on Render: the platform supplies it.

# ---------------------------------------------------------------- server
NODE_ENV=production
PORT=5000
# Number of proxies in front of the app. Render: 1. Add one more if a CDN
# (for example a Vercel rewrite) sits in front of Render as well.
TRUST_PROXY=1
# The site people actually open. Email links are built from it, so it must be
# the public address, with no trailing slash.
CLIENT_ORIGIN=https://your-app.vercel.app
# Optional extra origins, comma separated (custom domain, preview deployments).
# CLIENT_ORIGINS=

# ---------------------------------------------------------------- database
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/sms?retryWrites=true&w=majority

# ---------------------------------------------------------------- email
# The address every message is sent from. It is also the account that authorises
# the Gmail API.
SMTP_USER=you@gmail.com
MAIL_FROM_NAME=School Management System

# Gmail API over HTTPS. This is the one that works on hosts which block the SMTP
# ports (Render Free blocks 25, 465 and 587). Make the refresh token once with:
#   npm run google:token -- --port=53682
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# The older way: a 16-letter Gmail app password over SMTP. Fine locally, blocked
# on Render Free. One of the two sets must be complete, or the server refuses to
# start.
# SMTP_APP_PASSWORD=

# ---------------------------------------------------------------- secrets
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
CODE_HMAC_SECRET=

# ---------------------------------------------------------------- web push
# node scripts/generate-env.js prints a fresh pair if you ever need one.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@gmail.com

# ---------------------------------------------------------------- bot protection
# Cloudflare Turnstile. The secret is read only here; the matching site key is public and
# lives in the client as VITE_TURNSTILE_SITE_KEY. Leave this blank to turn the check off
# (local development). In production a blank value leaves the sign-in screens unguarded.
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------- image storage and certificates
# ImageKit stores student photos and certificate branding. Keep the private key and the
# webhook secret on the server only; the public key is used by ImageKit's upload widgets
# and is not a secret. The webhook URL must be exactly:
#   https://<api-host>/api/webhooks/imagekitA
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
IMAGEKIT_WEBHOOK_SECRET=
# Optional limits. Defaults: 5 MB shared photo limit, 300 px minimum photo edge,
# 472 px minimum edge for the 4 x 4 cm certificate photo.
# IMAGEKIT_PHOTO_MAX_BYTES=5000000
# IMAGEKIT_PHOTO_MIN_PX=300
# CERTIFICATE_PHOTO_MIN_PX=472

# ---------------------------------------------------------------- tuning (optional)
# ACCESS_TOKEN_TTL=10m
# REFRESH_TTL_DAYS=7
# REFRESH_ABSOLUTE_DAYS=30
# CODE_TTL_MINUTES=5
# CODE_RESEND_WAIT_SECONDS=120
# VERIFY_LINK_TTL_HOURS=3
# SETUP_TICKET_TTL_MINUTES=30
# RESET_LINK_TTL_MINUTES=30
# NOTIFICATION_TTL_DAYS=30
# MAX_DEVICES_USER=3
# MAX_DEVICES_ADMIN=2
